[Unit]
Description=Parametral OS gateway (JSON-RPC v1 tool API)
Documentation=file:///usr/share/doc/parametral/API-v1.md
After=local-fs.target harddenyd.service
Wants=harddenyd.service
ConditionPathExists=/etc/ultraos/policy/policy.v1.json

[Service]
Type=simple
User=ultraos
Group=ultraos
RuntimeDirectory=parametral
RuntimeDirectoryMode=0700
StateDirectory=ultraos
StateDirectoryMode=0700
ExecStart=/usr/local/bin/ultraosd \
    --policy /etc/ultraos/policy/policy.v1.json \
    --state /var/lib/ultraos \
    --socket /run/parametral/control.sock \
    --harddeny-socket /run/parametral/harddeny.sock
Restart=on-failure
RestartSec=2s
# The gateway needs to create child cgroups for sandboxes, so cgroup protection is off
# here (it stays on for the oracle). Everything else is locked down.
ReadOnlyPaths=/etc/ultraos /usr/local/bin
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
