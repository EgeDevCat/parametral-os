    "response": {
      "node_id": "local",
      "server_version": "0.1.0",
      "protocol_versions": [
        "v1"
      ],
      "selected": "v1",
      "features": [
        "sandbox.bwrap",
        "seccomp.blacklist-v1",
        "cgroup.v2",
        "audit.chain",
        "tokens.hmac",
        "approvals.desktop",
        "harddeny.oracle.v1"
      ],
      "policy_version": 1,
      "started_at": "2026-11-19T18:59:08Z"
    },
    "notes": "Must be the first call of a session. No common version -> INVALID_PARAMS (-32602) with data.supported. protocol_versions are negotiation labels ('v1'), not semver; the implementation version is server_version.",
    "verified_against": "live daemon, 2026-11-19 (keys and types taken from an actual v1.node.hello)"
  },
