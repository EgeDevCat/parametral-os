  "fail_closed": {
    "rule": "When the tier-2 oracle is unreachable, every state-changing method is refused with -32013.",
    "exempt": [
      "v1.node.hello",
      "v1.node.status",
      "v1.policy.explain",
      "v1.audit.verify",
      "v1.approvals.get",
      "v1.approvals.list",
      "v1.audit.query"
    ]
  },
  "capability_token": {
    "wire_format": "u1.<base64url(canonical_json(payload))>.<base64url(HMAC-SHA256(key, \"u1.\"+b64payload))>",
    "payload": {
      "v": "int",
      "tid": "tok_*",
      "node_id": "string",
      "ops": "sorted list of method names",
      "scope": {
        "sandbox_ids": "list|*",
        "commands": "list|*",
        "paths": "list of prefixes"
      },
      "iat": "iso8601",
      "exp": "iso8601",
      "max_uses": "int (atomic; enforced under flock)",
      "approval_id": "appr_*|null"
    },
    "binding_matrix": {
      "method": "ops (with OP_IMPLIES expansion)",
      "node_id": "yes",
      "expiry": "yes",
      "single_use": "yes — atomic under flock, exactly max_uses calls succeed",
      "approval_id": "yes",
      "params_digest": "NOT YET — planned for 1.6.0"
    },
    "issuance_rule": "If the policy requires approval, minting needs an approval_id whose state is approved, whose operation matches, and that is unexpired; the approval is consumed on use."
  },
