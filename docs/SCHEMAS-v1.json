{
  "contract": "parametral-os/tool-api",
  "version": "1.5.0",
  "status": "frozen-for-implementation",
  "planned": {
    "1.6.0": [
      "params_digest on capability tokens (binds a token to one exact params object)",
      "verdict checks gained {name, expected, actual, passed} (1.6 shape; 1.5.0 returns {check, ok, detail})"
    ]
  },
  "transport": {
    "kind": "jsonrpc-2.0",
    "socket": "/run/parametral/control.sock",
    "peer_model": "SO_PEERCRED; the daemon accepts only its own uid. Root is refused with -32010 PEER_REJECTED.",
    "framing": "one JSON object per line, UTF-8, request/response matched by id",
    "protocol_versions": [
      "v1"
    ],
    "server_version": "0.1.0"
  },
  "canonical_json": {
    "used_for": [
      "token body signature",
      "audit params_hash",
      "params_digest (1.6)"
    ],
    "rules": {
      "key_order": "sorted ascending by unicode code point",
      "separators": "',' and ':' with no whitespace",
      "ensure_ascii": false,
      "numbers": "integers as-is; floats use Python repr — NOT RFC 8785 ECMAScript number formatting"
    },
    "known_deviation": "RFC 8785 requires ECMAScript Number::toString formatting. Until that lands, any client sending float parameters must send them as strings or integers, otherwise signatures can differ between implementations.",
    "example": "{\"a\":\"ğ\",\"b\":1,\"c\":[1,2]}"
  },
  "envelope": {
    "request": {
      "jsonrpc": "\"2.0\"",
      "id": "string|number",
      "method": "v1.<resource>.<action>",
      "params": {
        "node_id": "optional; must equal the daemon node_id when present",
        "capability_token": "optional u1 token when the policy requires one"
      },
      "examples_extra": "approval_id (only for operations whose policy requires approval)"
    },
    "response_ok": {
      "jsonrpc": "\"2.0\"",
      "id": "echo",
      "result": "object"
    },
    "response_error": {
      "jsonrpc": "\"2.0\"",
      "id": "echo",
      "error": {
        "code": "int",
        "message": "string",
        "data": {
          "parametral_code": "string"
        }
      }
    }
  },
  "hello": {
    "method": "v1.node.hello",
    "request": {
      "jsonrpc": "2.0",
      "id": "h1",
      "method": "v1.node.hello",
      "params": {
        "protocol_versions": [
          "v1"
        ]
      }
